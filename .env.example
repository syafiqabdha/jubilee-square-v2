# Jubilee Square v2 Environment Configuration
#
# Copy to `.env` and fill in every REQUIRED value before starting the stack:
#   cp .env.example .env
# Validate a filled-in file with:  ./infra/coolify/check-envs.sh
#
# The values below are placeholders only. Never commit real credentials:
# `.env` is gitignored, this file is not.

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=jubilee_admin
# REQUIRED (no default in docker-compose.yml). Use URL-safe characters only —
# this value is interpolated into the postgresql:// connection string below.
DB_PASSWORD=change-me
DB_NAME=jubilee_square_v2
DATABASE_URL=postgresql://jubilee_admin:change-me@localhost:5432/jubilee_square_v2

# Catalog REST API
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=*
API_PREFIX=/api/v1

# Directus Headless CMS
DIRECTUS_PORT=8055
DIRECTUS_URL=http://localhost:8055
ADMIN_EMAIL=admin@jubileesq.com.sg
# REQUIRED (no default in docker-compose.yml) — rotate before production use.
ADMIN_PASSWORD=change-me
# REQUIRED (no defaults in docker-compose.yml). Generate: openssl rand -hex 32
# Rotating KEY/SECRET invalidates existing Directus sessions and tokens.
KEY=change-me
SECRET=change-me

# Web Application
PUBLIC_API_URL=http://localhost:3000
PUBLIC_DIRECTUS_URL=http://localhost:8055
WEB_PORT=4321
