# Jubilee Square v2 Environment Configuration
#
# Copy to `.env` and fill in every REQUIRED value:
#   cp .env.example .env && ${EDITOR:-vi} .env
#
# REQUIRED secrets have no default anywhere in the repo: docker-compose.yml refuses to
# start without them (${VAR:?} syntax), and the Directus bootstrap exits 1 if the admin
# credentials are missing. Generate values with: openssl rand -base64 32

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=jubilee_admin
# REQUIRED
DB_PASSWORD=
DB_NAME=jubilee_square_v2
# Keep the password here in sync with DB_PASSWORD above
DATABASE_URL=postgresql://jubilee_admin:REPLACE_WITH_DB_PASSWORD@localhost:5432/jubilee_square_v2

# Catalog REST API
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=*
API_PREFIX=/api/v1
# REQUIRED — Used for Directus webhook authentications
SYNC_SECRET=

# Directus Headless CMS
DIRECTUS_PORT=8055
DIRECTUS_URL=http://localhost:8055
# REQUIRED
ADMIN_EMAIL=
# REQUIRED
ADMIN_PASSWORD=
# REQUIRED — Directus session keys, use two distinct random values
KEY=
SECRET=

# Web Application
PUBLIC_API_URL=http://localhost:3000
PUBLIC_DIRECTUS_URL=http://localhost:8055
WEB_PORT=4321
