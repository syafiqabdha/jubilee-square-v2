# Jubilee Square v2 Environment Configuration
#
# Copy to `.env` and fill in every REQUIRED value:
#   cp .env.example .env && ${EDITOR:-vi} .env
#
# REQUIRED secrets have no default anywhere in the repo: docker-compose.yml refuses to
# start without them (${VAR:?} syntax), and the Directus bootstrap exits 1 if the admin
# credentials are missing. Generate values with: openssl rand -base64 32

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=jubilee_admin
# REQUIRED
DB_PASSWORD=
DB_NAME=jubilee_square_v2
# Keep the password here in sync with DB_PASSWORD above
DATABASE_URL=postgresql://jubilee_admin:REPLACE_WITH_DB_PASSWORD@localhost:5432/jubilee_square_v2

# Catalog REST API
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=*
API_PREFIX=/api/v1
# REQUIRED — shared secret for POST /api/v1/sync; the Directus bootstrap writes it
# into the 'Catalog Sync Hook' flow's x-sync-secret header
SYNC_SECRET=

# Directus Headless CMS
DIRECTUS_PORT=8055
DIRECTUS_URL=http://localhost:8055
# Public URL of the CMS (used in Directus links and emails), e.g. https://cms.example.com
DIRECTUS_PUBLIC_URL=http://localhost:8055
# Origins allowed to call the CMS API from a browser; "true" reflects the request origin
DIRECTUS_CORS_ORIGIN=true
# REQUIRED
ADMIN_EMAIL=
# REQUIRED
ADMIN_PASSWORD=
# REQUIRED — Directus session keys, use two distinct random values
KEY=
SECRET=

# Web Application
PUBLIC_API_URL=http://localhost:3000
PUBLIC_DIRECTUS_URL=http://localhost:8055
WEB_PORT=4321

# Docker stack
# Host interface the web / API / CMS ports bind to. Use 127.0.0.1 behind a reverse proxy.
BIND_ADDR=0.0.0.0

# Optional HTTPS proxy (docker compose --profile proxy up -d)
SITE_DOMAIN=
CMS_DOMAIN=
API_DOMAIN=
ACME_EMAIL=
