# syntax=docker/dockerfile:1.7
# Jubilee Square v2 — Catalog REST API (Fastify)
#
#   docker build -f infra/docker/Dockerfile.api -t jubilee-catalog-api .
#
ARG NODE_IMAGE=node:22-alpine

# ── 1. Install the full workspace from the lockfile ──────────────────────────
FROM ${NODE_IMAGE} AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/db/package.json packages/db/
COPY apps/web/package.json apps/web/
COPY apps/catalog-api/package.json apps/catalog-api/
COPY apps/directus/package.json apps/directus/
RUN --mount=type=cache,target=/root/.npm npm ci --no-audit --no-fund

# ── 2. Build ─────────────────────────────────────────────────────────────────
FROM deps AS build
COPY tsconfig.json ./
COPY packages/ packages/
COPY apps/catalog-api/ apps/catalog-api/
RUN npm run build --workspace=@jubilee/shared \
 && npm run build --workspace=@jubilee/db \
 && npm run build --workspace=@jubilee/catalog-api

# ── 3. Production dependencies only, for the API workspace ───────────────────
FROM deps AS prod-deps
RUN --mount=type=cache,target=/root/.npm \
    npm ci --omit=dev --no-audit --no-fund --workspace=@jubilee/catalog-api

# ── 4. Runtime ───────────────────────────────────────────────────────────────
FROM ${NODE_IMAGE} AS runtime
WORKDIR /app
ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=3000

# Production node_modules, including any workspace-local (nested) ones that npm
# could not hoist, plus every workspace manifest so the @jubilee/* links resolve.
COPY --from=prod-deps --chown=node:node /app ./
COPY --from=build --chown=node:node /app/packages/shared/dist ./packages/shared/dist
COPY --from=build --chown=node:node /app/packages/db/dist ./packages/db/dist
COPY --from=build --chown=node:node /app/apps/catalog-api/dist ./apps/catalog-api/dist

USER node
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=5s --start-period=15s --retries=5 \
  CMD wget -qO- "http://127.0.0.1:${PORT}/health" >/dev/null || exit 1
CMD ["node", "apps/catalog-api/dist/server.js"]
