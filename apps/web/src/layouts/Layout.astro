---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import TenantDrawer from '../components/TenantDrawer.astro';
import BottomNav from '../components/BottomNav.astro';
import SearchModal from '../components/SearchModal.astro';
import BuildingLightbox from '../components/BuildingLightbox.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  activePage?: string;
  image?: string;
}

const {
  title = 'Jubilee Square — Ang Mo Kio Shopping, Dining & Enrichment Hub',
  description = 'Jubilee Square at 61 Ang Mo Kio Ave 8 offers 23 curated tenants across dining, enrichment tuition, beauty wellness, and healthcare. 2 min from AMK MRT.',
  activePage = 'home',
  image = '/images/jubilee_sq_building.jpg',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <link rel="icon" type="image/svg+xml" href="/brand/jubilee-square-mark.svg" />
  <link rel="apple-touch-icon" href="/brand/jubilee-square-mark.png" />
  <title>{title}</title>
  <meta name="description" content={description} />
  
  <!-- Open Graph / Social Sharing Previews -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="en_SG" />
  <meta property="og:image" content={image} />
  <meta property="og:site_name" content="Jubilee Square" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={image} />

  <!-- Typography & Modern Sans Hierarchy (The Sans / Plus Jakarta Sans / Inter Fallback) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body class="bg-slate-50 text-slate-800 font-sans min-h-screen flex flex-col antialiased selection:bg-jubilee-red selection:text-white">
  <Nav activePage={activePage} />
  
  <main class="flex-1 w-full max-w-full overflow-x-hidden">
    <slot />
  </main>
  
  <TenantDrawer />
  <SearchModal />
  <BuildingLightbox />
  <BottomNav activePage={activePage} />
  <Footer />
</body>
</html>
