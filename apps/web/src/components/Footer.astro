---
---

<footer class="bg-white border-t border-slate-200 pt-12 pb-16 md:pb-12 text-slate-600" role="contentinfo">
  <div class="max-w-7xl mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
      <!-- Brand & Info -->
      <div class="md:col-span-2">
        <a href="/" class="inline-block mb-4" aria-label="Jubilee Square Home">
          <img
            src="/brand/jubilee-square-logo.png"
            alt="Jubilee Square by ENGWAH"
            class="h-9 w-auto"
            width="127"
            height="36"
            loading="lazy"
            decoding="async"
          />
        </a>
        <p class="text-sm text-slate-500 max-w-sm mb-4 leading-relaxed">
          61 Ang Mo Kio Ave 8, Singapore 569814.<br />
          Located in the heart of Ang Mo Kio, 2 minutes sheltered walk from Ang Mo Kio MRT Station (NS16 Exit C) &amp; Bus Interchange.
        </p>
        <div class="text-xs text-slate-600">
          <p class="mb-2">Managed and owned by</p>
          <img
            src="/brand/engwah-global-logo.png"
            alt="Eng Wah Global"
            class="h-5 w-auto"
            width="77"
            height="20"
            loading="lazy"
            decoding="async"
          />
        </div>

        <!-- Social media -->
        <div class="mt-6">
          <p class="text-xs font-bold uppercase tracking-wider text-slate-900 mb-3">Follow us</p>
          <ul class="flex items-center gap-3" role="list">
            <li>
              <a
                href="https://www.facebook.com/jubileesq"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Jubilee Square on Facebook"
                class="social-link"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M24 12.07C24 5.41 18.63 0 12 0S0 5.41 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.96.93-1.96 1.89v2.25h3.33l-.53 3.49h-2.8V24C19.61 23.1 24 18.1 24 12.07z"/>
                </svg>
              </a>
            </li>
            <li>
              <a
                href="https://www.instagram.com/jubileesquare/"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Jubilee Square on Instagram"
                class="social-link"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="2" y="2" width="20" height="20" rx="5.5"/>
                  <circle cx="12" cy="12" r="4.25"/>
                  <circle cx="17.6" cy="6.4" r="0.9" fill="currentColor" stroke="none"/>
                </svg>
              </a>
            </li>
          </ul>
        </div>
      </div>

      <!-- Quick Navigation -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900 mb-4">Explore Directory</h3>
        <ul class="space-y-2.5 text-sm font-medium">
          <li><a href="/directory" class="hover:text-jubilee-navy transition-colors">🏬 All 23 Stores</a></li>
          <li><a href="/dine" class="hover:text-jubilee-navy transition-colors">🍜 Food &amp; Dining (6)</a></li>
          <li><a href="/learn" class="hover:text-jubilee-navy transition-colors">📚 Tuition &amp; Music (9)</a></li>
          <li><a href="/relax" class="hover:text-jubilee-navy transition-colors">💆 Beauty &amp; Wellness (5)</a></li>
          <li><a href="/shop" class="hover:text-jubilee-navy transition-colors">🛍️ Retail &amp; Specialty (2)</a></li>
          <li><a href="/services" class="hover:text-jubilee-navy transition-colors">🩺 TCM Clinic &amp; Care (1)</a></li>
        </ul>
      </div>

      <!-- Mall & Management Info -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900 mb-4">Mall Information</h3>
        <ul class="space-y-2.5 text-sm font-medium">
          <li><a href="/location" class="hover:text-jubilee-navy transition-colors">🧭 Getting Here &amp; Parking</a></li>
          <li><a href="/deals" class="hover:text-jubilee-navy transition-colors">🏷️ Deals &amp; Promotions</a></li>
          <li><a href="/news" class="hover:text-jubilee-navy transition-colors">📰 News &amp; Updates</a></li>
          <li><a href="/about" class="hover:text-jubilee-navy transition-colors">ℹ️ About the Mall</a></li>
          <li><a href="/contact" class="hover:text-jubilee-navy transition-colors">✉️ Contact &amp; Leasing</a></li>
          <li><a href="/signage" class="hover:text-jubilee-navy transition-colors">📺 Digital Signage Kiosk</a></li>
          <li><a href="/terms" class="hover:text-jubilee-navy transition-colors">📄 Privacy Policy &amp; Terms</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <div>
        &copy; {new Date().getFullYear()} Jubilee Square. All rights reserved. Eng Wah Properties.
      </div>
      <div class="flex items-center gap-6">
        <a href="/terms" class="hover:text-slate-900 transition-colors">Terms of Service</a>
        <a href="/terms" class="hover:text-slate-900 transition-colors">Privacy Policy</a>
        <a href="/location#parking" class="hover:text-slate-900 transition-colors">Car Park Rates</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 9999px;
    background: var(--color-brand-navy, #252F81);
    color: #fff;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }
  .social-link:hover {
    background: var(--color-brand-magenta, #C60A4D);
    transform: translateY(-1px);
  }
  .social-link:focus-visible {
    outline: 2px solid var(--color-brand-magenta, #C60A4D);
    outline-offset: 2px;
  }
</style>
