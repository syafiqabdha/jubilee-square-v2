---
interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = "Your Community & Lifestyle Hub in Ang Mo Kio",
  subtitle = "Discover 23 curated eateries, premier enrichment academies, wellness spas, and essential community healthcare across 4 convenient levels — just 2 minutes from Ang Mo Kio MRT.",
} = Astro.props;
---

<section class="relative overflow-hidden bg-white border-b border-slate-200/80 pt-12 pb-16 md:pt-20 md:pb-24 px-4" aria-labelledby="hero-heading">
  <!-- Subtle Brand Gradient Orbs -->
  <div class="absolute -top-24 -left-24 w-96 h-96 bg-jubilee-navy-light rounded-full blur-3xl opacity-50 pointer-events-none" aria-hidden="true"></div>
  <div class="absolute -bottom-24 -right-24 w-96 h-96 bg-jubilee-red-light rounded-full blur-3xl opacity-60 pointer-events-none" aria-hidden="true"></div>

  <div class="relative max-w-5xl mx-auto text-center z-10">
    <!-- Main Heading -->
    <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold text-slate-900 tracking-tight leading-[1.1] mb-6 text-balance" id="hero-heading">
      {title}
    </h1>

    <!-- Subtitle -->
    <p class="text-lg sm:text-xl text-slate-600 max-w-3xl mx-auto leading-relaxed mb-8 text-pretty">
      {subtitle}
    </p>

    <!-- CTAs -->
    <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-4 mb-10">
      <a href="/directory" class="btn-primary-navy">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        Browse Store Directory
      </a>

      <a href="/location" class="btn-secondary-outline">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="3 11 22 2 13 21 11 13 3 11"></polygon>
        </svg>
        Getting Here &amp; Parking
      </a>
    </div>

    <!-- Quick Discovery Category Chips -->
    <div class="pt-6 border-t border-slate-100 flex flex-wrap items-center justify-center gap-2 sm:gap-3 text-sm font-semibold">
      <span class="text-xs uppercase tracking-wider text-slate-400 mr-1">Quick Jump:</span>
      <a href="/dine" class="px-3.5 py-1.5 rounded-full bg-slate-100 hover:bg-jubilee-red-light text-slate-700 hover:text-jubilee-red border border-slate-200 transition-colors">
        🍜 Dine &amp; Food
      </a>
      <a href="/learn" class="px-3.5 py-1.5 rounded-full bg-slate-100 hover:bg-jubilee-navy-light text-slate-700 hover:text-jubilee-navy border border-slate-200 transition-colors">
        📚 Tuition &amp; Music
      </a>
      <a href="/relax" class="px-3.5 py-1.5 rounded-full bg-slate-100 hover:bg-purple-50 text-slate-700 hover:text-purple-700 border border-slate-200 transition-colors">
        💆 Hair &amp; Spa
      </a>
      <a href="/services" class="px-3.5 py-1.5 rounded-full bg-slate-100 hover:bg-emerald-50 text-slate-700 hover:text-emerald-700 border border-slate-200 transition-colors">
        🩺 TCM &amp; Clinic
      </a>
    </div>
  </div>
</section>
