---
interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = "Your Community & Lifestyle Hub in Ang Mo Kio",
  subtitle = "Discover 23 curated eateries, premier enrichment academies, wellness spas, and essential community healthcare across 4 convenient levels — just 2 minutes from Ang Mo Kio MRT.",
} = Astro.props;
---

<section class="relative overflow-hidden bg-white border-b border-slate-200/80 pt-12 pb-16 md:pt-20 md:pb-24 px-4" aria-labelledby="hero-heading">
  <!-- Ambient Architectural Backdrop (Subtle Faded Effect) -->
  <div
    class="absolute inset-0 pointer-events-none opacity-[0.04] sm:opacity-[0.06] bg-cover bg-center select-none"
    style="background-image: url('/images/jubilee_sq_building.jpg'); mask-image: radial-gradient(ellipse at 50% 25%, black 25%, transparent 75%); -webkit-mask-image: radial-gradient(ellipse at 50% 25%, black 25%, transparent 75%);"
    aria-hidden="true"
  ></div>

  <!-- Subtle Brand Gradient Orbs -->
  <div class="absolute -top-24 -left-24 w-96 h-96 bg-jubilee-navy-light rounded-full blur-3xl opacity-50 pointer-events-none" aria-hidden="true"></div>
  <div class="absolute -bottom-24 -right-24 w-96 h-96 bg-jubilee-red-light rounded-full blur-3xl opacity-60 pointer-events-none" aria-hidden="true"></div>

  <div class="relative max-w-5xl mx-auto text-center z-10">
    <!-- Main Heading -->
    <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold text-slate-900 tracking-tight leading-[1.1] mb-6 text-balance" id="hero-heading">
      {title}
    </h1>

    <!-- Subtitle -->
    <p class="text-lg sm:text-xl text-slate-600 max-w-3xl mx-auto leading-relaxed mb-8 text-pretty">
      {subtitle}
    </p>

    <!-- CTAs -->
    <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-4 mb-10">
      <a href="/directory" class="btn-primary-navy">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        Browse Store Directory
      </a>

      <a href="/location" class="btn-secondary-outline">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="3 11 22 2 13 21 11 13 3 11"></polygon>
        </svg>
        Getting Here &amp; Parking
      </a>
    </div>

    <!-- Quick Discovery Category Chips -->
    <div class="pt-6 border-t border-slate-100 flex flex-wrap items-center justify-center gap-2 sm:gap-3 text-sm font-semibold mb-12">
      <span class="text-xs uppercase tracking-wider text-slate-400 mr-1">Quick Jump:</span>
      <a href="/dine" class="px-3.5 py-1.5 rounded-full bg-slate-100 hover:bg-jubilee-red-light text-slate-700 hover:text-jubilee-red border border-slate-200 transition-colors">
        🍜 Dine &amp; Food
      </a>
      <a href="/learn" class="px-3.5 py-1.5 rounded-full bg-slate-100 hover:bg-jubilee-navy-light text-slate-700 hover:text-jubilee-navy border border-slate-200 transition-colors">
        📚 Tuition &amp; Music
      </a>
      <a href="/relax" class="px-3.5 py-1.5 rounded-full bg-slate-100 hover:bg-purple-50 text-slate-700 hover:text-purple-700 border border-slate-200 transition-colors">
        💆 Hair &amp; Spa
      </a>
      <a href="/services" class="px-3.5 py-1.5 rounded-full bg-slate-100 hover:bg-emerald-50 text-slate-700 hover:text-emerald-700 border border-slate-200 transition-colors">
        🩺 TCM &amp; Clinic
      </a>
    </div>

    <!-- Jubilee Square Mall Exterior Showcase Card -->
    <div class="relative max-w-4xl mx-auto text-left">
      <div class="group relative rounded-2xl sm:rounded-3xl overflow-hidden border border-slate-200/90 shadow-xl shadow-slate-900/5 bg-slate-950 aspect-[16/10] sm:aspect-[21/9] max-h-[420px] transition-all duration-300 hover:shadow-2xl hover:border-slate-300">
        <!-- Building Image with subtle smooth scale on hover -->
        <img
          src="/images/jubilee_sq_building.jpg"
          alt="Jubilee Square building exterior facade with colorful geometric design in Ang Mo Kio Central"
          class="w-full h-full object-cover object-center group-hover:scale-[1.025] transition-transform duration-700 ease-out"
          loading="eager"
          fetchpriority="high"
          width="1280"
          height="720"
        />

        <!-- Deep Dark Scrim Gradient for Legibility -->
        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-slate-950/30 to-slate-950/10 pointer-events-none"></div>

        <!-- Top Floating Badges -->
        <div class="absolute top-3 sm:top-4 left-3 sm:left-4 right-3 sm:right-4 flex items-center justify-between pointer-events-none z-10">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-bold text-white bg-slate-950/75 backdrop-blur-md border border-white/20 shadow-md">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            Open Daily • 10:00 AM – 10:00 PM
          </div>

          <div class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold text-white/95 bg-slate-950/75 backdrop-blur-md border border-white/20 shadow-md">
            <span>📍</span> 61 Ang Mo Kio Ave 8
          </div>
        </div>

        <!-- Bottom Content Overlay -->
        <div class="absolute bottom-3 sm:bottom-5 left-3 sm:left-5 right-3 sm:right-5 flex flex-col sm:flex-row sm:items-end justify-between gap-3 text-left pointer-events-none z-10">
          <div>
            <div class="inline-flex items-center gap-1.5 text-[11px] sm:text-xs font-bold uppercase tracking-wider text-rose-300 mb-1">
              <span>🏛️</span> Landmark &amp; Community Mall
            </div>
            <h2 class="text-lg sm:text-2xl font-black text-white tracking-tight leading-snug drop-shadow-md">
              Jubilee Square (Ang Mo Kio Central)
            </h2>
            <p class="text-xs sm:text-sm text-slate-300 max-w-xl line-clamp-1 sm:line-clamp-2 mt-0.5">
              4 Levels of dining, academic enrichment, wellness &amp; medical clinics — 2 mins sheltered from AMK MRT.
            </p>
          </div>

          <!-- Quick Badges & Preview Trigger Pill -->
          <div class="flex items-center gap-2 self-start sm:self-end">
            <span class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-xl bg-white/15 backdrop-blur-md border border-white/20 text-[11px] sm:text-xs font-medium text-white shadow-sm">
              🚇 Exit C Linkway
            </span>
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-jubilee-red/90 hover:bg-jubilee-red backdrop-blur-md text-white text-[11px] sm:text-xs font-bold shadow-md transition-all">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
              View Full Photo
            </span>
          </div>
        </div>

        <!-- Accessible Click Trigger for Lightbox -->
        <button
          type="button"
          class="absolute inset-0 w-full h-full cursor-pointer focus:outline-none focus:ring-2 focus:ring-jubilee-navy focus:ring-offset-2 z-20"
          data-open-building-lightbox
          aria-label="Click to enlarge and view details of Jubilee Square mall building facade"
        >
          <span class="sr-only">Click to view full photograph of Jubilee Square building facade</span>
        </button>
      </div>
    </div>
  </div>
</section>
