---
// Building Lightbox / Modal for high-res Jubilee Square landmark inspection
---

<div
  class="building-lightbox-backdrop fixed inset-0 z-[250] bg-slate-950/80 backdrop-blur-md hidden items-center justify-center p-4 sm:p-6 opacity-0 transition-opacity duration-300 ease-out"
  id="building-lightbox-modal"
  role="dialog"
  aria-modal="true"
  aria-label="Jubilee Square Landmark Facade Photograph"
  aria-hidden="true"
>
  <div class="building-lightbox-card relative w-full max-w-4xl bg-slate-900 border border-slate-700/80 rounded-2xl sm:rounded-3xl shadow-2xl overflow-hidden flex flex-col transform scale-95 transition-transform duration-300 ease-out">
    <!-- Modal Header -->
    <div class="flex items-center justify-between px-5 py-4 border-b border-slate-800 bg-slate-900/90">
      <div class="flex items-center gap-2.5">
        <span class="w-2.5 h-2.5 rounded-full bg-[#C60A4D]"></span>
        <div>
          <h3 class="text-sm sm:text-base font-bold text-white leading-none">
            Jubilee Square Building Landmark
          </h3>
          <p class="text-xs text-slate-400 mt-0.5">
            61 Ang Mo Kio Ave 8, Singapore 569814
          </p>
        </div>
      </div>

      <button
        type="button"
        id="building-lightbox-close"
        class="w-8 h-8 rounded-full bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white flex items-center justify-center transition-colors focus:outline-none focus:ring-2 focus:ring-[#C60A4D]"
        aria-label="Close landmark photograph view"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M3 3l10 10M13 3L3 13" />
        </svg>
      </button>
    </div>

    <!-- Image Display Frame -->
    <div class="relative bg-black flex items-center justify-center overflow-hidden max-h-[70vh]">
      <img
        src="/images/jubilee_sq_building.jpg"
        alt="Jubilee Square mall exterior facade showing the colorful geometric triangle mosaic and street directional signage in Ang Mo Kio Central"
        class="w-full h-auto max-h-[70vh] object-contain select-none"
        loading="lazy"
        width="1280"
        height="960"
        id="building-lightbox-img"
      />
    </div>

    <!-- Modal Footer / Landmark Context -->
    <div class="px-5 py-4 bg-slate-900 border-t border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="text-xs text-slate-300 space-y-1">
        <p class="font-semibold text-white">
          Distinctive Facade &amp; Central Access
        </p>
        <p class="text-slate-400">
          Features the signature multi-colored mosaic and is directly connected to Ang Mo Kio MRT Station (NS16 Exit C) &amp; Bus Interchange via sheltered linkway.
        </p>
      </div>

      <div class="flex items-center gap-2.5 shrink-0">
        <a
          href="https://maps.google.com/?q=61+Ang+Mo+Kio+Ave+8+Singapore+569814"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-xs font-bold text-white bg-[#C60A4D] hover:bg-[#9E083E] transition-colors shadow-sm"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="3 11 22 2 13 21 11 13 3 11"></polygon>
          </svg>
          Google Maps
        </a>
        <a
          href="/location"
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-xs font-semibold text-slate-200 bg-slate-800 hover:bg-slate-700 hover:text-white transition-colors"
        >
          Transit &amp; Parking
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  function setupBuildingLightbox() {
    const modal = document.getElementById('building-lightbox-modal');
    const closeBtn = document.getElementById('building-lightbox-close');
    const card = modal?.querySelector('.building-lightbox-card');

    if (!modal || !closeBtn) return;

    function openModal() {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';

      // Trigger animation frame
      requestAnimationFrame(() => {
        modal.classList.remove('opacity-0');
        modal.classList.add('opacity-100');
        card?.classList.remove('scale-95');
        card?.classList.add('scale-100');
      });

      closeBtn.focus();
    }

    function closeModal() {
      modal.classList.remove('opacity-100');
      modal.classList.add('opacity-0');
      card?.classList.remove('scale-100');
      card?.classList.add('scale-95');

      setTimeout(() => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        modal.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }, 300);
    }

    // Bind triggers across the page
    document.querySelectorAll('[data-open-building-lightbox]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        openModal();
      });
    });

    closeBtn.addEventListener('click', closeModal);

    // Backdrop click closes
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    // ESC key closes
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });

    // Expose global helper
    (window as any).openBuildingLightbox = openModal;
    (window as any).closeBuildingLightbox = closeModal;
  }

  // Init on DOM load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupBuildingLightbox);
  } else {
    setupBuildingLightbox();
  }
</script>
