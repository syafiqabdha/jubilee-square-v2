---
---

<div class="drawer-backdrop" id="tenant-drawer-backdrop" role="presentation"></div>

<aside
  class="drawer-panel"
  id="tenant-drawer-panel"
  role="dialog"
  aria-modal="true"
  aria-label="Tenant Details"
  aria-hidden="true"
>
  <!-- Top Bar -->
  <div class="drawer-top-bar">
    <div>
      <span class="text-xs font-bold uppercase tracking-wider text-jubilee-navy bg-jubilee-navy-light px-2.5 py-1 rounded-full" id="drawer-category">
        Category
      </span>
    </div>
    <button class="drawer-btn-close" id="drawer-close-btn" aria-label="Close details">
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
        <path d="M4 4l10 10M14 4L4 14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <!-- Content Body -->
  <div class="drawer-content-body">
    <!-- Tenant Logo Banner -->
    <div class="drawer-logo-container hidden" id="drawer-logo-wrap">
      <img id="drawer-logo-img" src="" alt="" class="drawer-logo-img" width="240" height="130" />
    </div>

    <!-- Header -->
    <div>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 leading-tight mb-2" id="drawer-store-name">
        Store Name
      </h2>
      <div class="flex items-center gap-3 text-sm font-semibold text-slate-600">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-slate-100 rounded-lg" id="drawer-location-badge">
          📍 Level 1 • #01-08
        </span>
        <span class="inline-flex items-center gap-1 px-3 py-1 rounded-lg" id="drawer-status-pill">
          🟢 Open Today
        </span>
      </div>
    </div>

    <!-- Direct Action CTA Buttons -->
    <div class="drawer-action-group">
      <a href="tel:+656****0000" class="btn-drawer-action btn-drawer-primary w-full justify-center" id="drawer-call-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
        </svg>
        <span id="drawer-call-text">Call Store</span>
      </a>
      <!-- WhatsApp click-to-chat CTA -->
      <a href="https://wa.me/" target="_blank" rel="noopener noreferrer" class="btn-drawer-action btn-drawer-whatsapp w-full justify-center hidden" id="drawer-whatsapp-btn" aria-label="Chat with store on WhatsApp">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
        </svg>
        <span>Chat on WhatsApp</span>
      </a>
    </div>

    <!-- About Section -->
    <div class="border-t border-slate-100 pt-5">
      <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">About the Store</h3>
      <p class="text-slate-700 leading-relaxed text-sm sm:text-base" id="drawer-description">
        Store description goes here.
      </p>
    </div>

    <!-- Interactive Floor Map Pin Callout -->
    <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-lg bg-jubilee-navy-light text-jubilee-navy flex items-center justify-center font-bold text-lg">
          🗺️
        </div>
        <div>
          <div class="text-sm font-bold text-slate-900" id="drawer-map-level">Level 1 Directory Pin</div>
          <div class="text-xs text-slate-500">Ang Mo Kio Jubilee Square</div>
        </div>
      </div>
      <a href="/location" class="text-xs font-bold text-jubilee-navy hover:text-jubilee-red underline">
        View Mall Map →
      </a>
    </div>

    <!-- Contact & Details Grid -->
    <div class="border-t border-slate-100 pt-5">
      <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3">Store Details</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" id="drawer-details-grid">
        <!-- Injected dynamically via safe DOM nodes -->
      </div>
    </div>

    <!-- 7-Day Operating Hours with live open/closed indicators -->
    <div class="border-t border-slate-100 pt-5">
      <div class="flex items-center justify-between mb-3">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400">Weekly Operating Hours</h3>
        <span class="text-[10px] font-semibold text-slate-400 bg-slate-100 px-2 py-0.5 rounded-full" id="drawer-hours-timezone">SGT (UTC+8)</span>
      </div>
      <div class="flex flex-col gap-1" id="drawer-hours-list">
        <!-- Injected dynamically via safe DOM nodes -->
      </div>
    </div>

    <!-- Directions CTA -->
    <div class="pt-2">
      <a
        href="https://maps.google.com/?q=61+Ang+Mo+Kio+Ave+8+Singapore+569814"
        target="_blank"
        rel="noopener noreferrer"
        class="w-full py-3 px-4 bg-slate-900 hover:bg-slate-800 text-white rounded-xl font-bold text-sm flex items-center justify-center gap-2 transition-colors"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="3 11 22 2 13 21 11 13 3 11"></polygon>
        </svg>
        Navigate to Jubilee Square on Google Maps
      </a>
    </div>
  </div>
</aside>

<script>
  import { getTenantOpeningStatus, DAYS_OF_WEEK, formatTimeShort } from '../lib/opening-hours';

  const backdrop = document.getElementById('tenant-drawer-backdrop');
  const panel = document.getElementById('tenant-drawer-panel');
  const closeBtn = document.getElementById('drawer-close-btn');

  const catEl = document.getElementById('drawer-category');
  const nameEl = document.getElementById('drawer-store-name');
  const locationEl = document.getElementById('drawer-location-badge');
  const statusPill = document.getElementById('drawer-status-pill');
  const descEl = document.getElementById('drawer-description');
  const mapLevelEl = document.getElementById('drawer-map-level');
  const detailsGrid = document.getElementById('drawer-details-grid');
  const hoursList = document.getElementById('drawer-hours-list');
  const logoWrap = document.getElementById('drawer-logo-wrap');
  const logoImg = document.getElementById('drawer-logo-img') as HTMLImageElement | null;

  const callBtn = document.getElementById('drawer-call-btn') as HTMLAnchorElement | null;
  const callText = document.getElementById('drawer-call-text');
  const whatsappBtn = document.getElementById('drawer-whatsapp-btn') as HTMLAnchorElement | null;

  function isValidWebUrl(urlString: string | null | undefined): boolean {
    if (!urlString || typeof urlString !== 'string') return false;
    try {
      const parsed = new URL(urlString.trim());
      return parsed.protocol === 'http:' || parsed.protocol === 'https:';
    } catch {
      return false;
    }
  }

  function sanitizeTenantData(data: any) {
    if (!data || typeof data !== 'object') return null;
    return {
      id: typeof data.id === 'string' ? data.id : '',
      slug: typeof data.slug === 'string' ? data.slug : '',
      name: typeof data.name === 'string' ? data.name : 'Store Profile',
      logoUrl: typeof data.logoUrl === 'string' ? data.logoUrl : null,
      categoryName: typeof data.categoryName === 'string' ? data.categoryName : 'Directory',
      floorLevel: typeof data.floorLevel === 'string' ? data.floorLevel : 'L1',
      unitNumber: typeof data.unitNumber === 'string' ? data.unitNumber : '',
      summary: typeof data.summary === 'string' ? data.summary : '',
      description: typeof data.description === 'string' ? data.description : (typeof data.summary === 'string' ? data.summary : ''),
      phone: typeof data.phone === 'string' ? data.phone : null,
      whatsapp: typeof data.whatsapp === 'string' ? data.whatsapp : null,
      email: typeof data.email === 'string' ? data.email : null,
      website: typeof data.website === 'string' ? data.website : null,
      tags: Array.isArray(data.tags) ? data.tags.filter((t: any) => typeof t === 'string') : [],
      operatingHours: Array.isArray(data.operatingHours) ? data.operatingHours : [],
    };
  }

  /**
   * Normalises a raw phone/WhatsApp number to an E.164-like string suitable for wa.me links.
   * Strips non-digit chars, preserves a leading +.
   */
  function sanitizeWhatsAppNumber(raw: string): string {
    const withPlus = raw.trim().startsWith('+');
    const digits = raw.replace(/\D/g, '');
    return withPlus ? `+${digits}` : digits;
  }

  function populateDrawerUI(rawTenant: any) {
    const tenant = sanitizeTenantData(rawTenant);
    if (!tenant) return;

    if (tenant.logoUrl && logoImg && logoWrap) {
      logoImg.src = tenant.logoUrl;
      logoImg.alt = `${tenant.name} Logo`;
      logoWrap.classList.remove('hidden');
    } else if (logoWrap) {
      logoWrap.classList.add('hidden');
    }

    if (catEl) catEl.textContent = tenant.categoryName;
    if (nameEl) nameEl.textContent = tenant.name;
    if (locationEl) locationEl.textContent = `📍 ${tenant.floorLevel} • ${tenant.unitNumber}`;
    if (mapLevelEl) mapLevelEl.textContent = `${tenant.floorLevel} Directory Pin (${tenant.unitNumber})`;
    if (descEl) descEl.textContent = tenant.description || tenant.summary || 'Visit us in Jubilee Square.';

    // Live status using shared engine
    const status = getTenantOpeningStatus(tenant.operatingHours);
    if (statusPill) {
      if (status.isOpen) {
        statusPill.className = 'inline-flex items-center gap-1 px-3 py-1 rounded-lg bg-emerald-50 text-emerald-700 font-bold text-xs border border-emerald-200';
        statusPill.textContent = `🟢 ${status.statusText}`;
      } else {
        statusPill.className = 'inline-flex items-center gap-1 px-3 py-1 rounded-lg bg-rose-50 text-rose-700 font-bold text-xs border border-rose-200';
        statusPill.textContent = `🔴 ${status.statusText}`;
      }
    }

    // Phone / Call Button
    if (callBtn) {
      if (tenant.phone) {
        const cleanPhone = tenant.phone.replace(/[^\d+]/g, '');
        callBtn.href = `tel:${cleanPhone}`;
        callBtn.style.display = 'inline-flex';
        if (callText) callText.textContent = tenant.phone;
      } else {
        callBtn.style.display = 'none';
      }
    }

    // WhatsApp click-to-chat button
    if (whatsappBtn) {
      const waSource = tenant.whatsapp || tenant.phone;
      if (waSource) {
        const cleanNumber = sanitizeWhatsAppNumber(waSource);
        const waUrl = `https://wa.me/${cleanNumber}`;
        whatsappBtn.href = waUrl;
        whatsappBtn.classList.remove('hidden');
        whatsappBtn.style.display = 'inline-flex';
      } else {
        whatsappBtn.classList.add('hidden');
        whatsappBtn.style.display = 'none';
      }
    }

    // Details Grid constructed with safe DOM nodes
    if (detailsGrid) {
      const fragment = document.createDocumentFragment();

      if (tenant.phone) {
        const card = document.createElement('div');
        card.className = 'p-3 bg-slate-50 rounded-lg';
        const label = document.createElement('div');
        label.className = 'text-xs font-semibold text-slate-400 uppercase';
        label.textContent = 'Phone';
        const val = document.createElement('div');
        val.className = 'text-sm font-bold text-slate-800';
        val.textContent = tenant.phone;
        card.append(label, val);
        fragment.appendChild(card);
      }

      if (tenant.email) {
        const card = document.createElement('div');
        card.className = 'p-3 bg-slate-50 rounded-lg';
        const label = document.createElement('div');
        label.className = 'text-xs font-semibold text-slate-400 uppercase';
        label.textContent = 'Email';
        const val = document.createElement('a');
        val.className = 'text-sm font-bold text-jubilee-navy hover:underline break-all';
        val.href = `mailto:${encodeURIComponent(tenant.email)}`;
        val.textContent = tenant.email;
        card.append(label, val);
        fragment.appendChild(card);
      }

      if (tenant.website && isValidWebUrl(tenant.website)) {
        const card = document.createElement('div');
        card.className = 'p-3 bg-slate-50 rounded-lg';
        const label = document.createElement('div');
        label.className = 'text-xs font-semibold text-slate-400 uppercase';
        label.textContent = 'Website';
        const link = document.createElement('a');
        link.className = 'text-sm font-bold text-jubilee-navy hover:underline';
        link.href = tenant.website;
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
        link.textContent = 'Visit Store Site ↗';
        card.append(label, link);
        fragment.appendChild(card);
      }

      if (tenant.tags && tenant.tags.length > 0) {
        const card = document.createElement('div');
        card.className = 'p-3 bg-slate-50 rounded-lg col-span-full';
        const label = document.createElement('div');
        label.className = 'text-xs font-semibold text-slate-400 uppercase';
        label.textContent = 'Tags';
        const val = document.createElement('div');
        val.className = 'text-sm font-medium text-slate-700';
        val.textContent = tenant.tags.join(', ');
        card.append(label, val);
        fragment.appendChild(card);
      }

      detailsGrid.replaceChildren(fragment);
    }

    // 7-Day Operating Hours — full breakdown with live per-day open/closed indicators
    if (hoursList) {
      const fragment = document.createDocumentFragment();
      const now = new Date();
      const todayIndex = now.getDay();
      const currentMinutes = now.getHours() * 60 + now.getMinutes();

      DAYS_OF_WEEK.forEach((dayName, idx) => {
        const isToday = idx === todayIndex;
        const tenantHour = tenant.operatingHours?.find((h: any) => h.dayOfWeek === idx);

        let timeStr = '10:00 – 21:30';
        let isClosed = false;
        let openMins: number | null = null;
        let closeMins: number | null = null;

        if (tenantHour) {
          if (tenantHour.isClosed) {
            timeStr = 'Closed';
            isClosed = true;
          } else {
            const openFmt = formatTimeShort(tenantHour.openTime);
            const closeFmt = formatTimeShort(tenantHour.closeTime, '21:30');
            timeStr = `${openFmt} – ${closeFmt}`;

            // Parse open/close minutes for live indicator on today
            if (tenantHour.openTime) {
              const parts = tenantHour.openTime.split(':');
              if (parts.length >= 2) openMins = parseInt(parts[0], 10) * 60 + parseInt(parts[1], 10);
            }
            if (tenantHour.closeTime) {
              const parts = tenantHour.closeTime.split(':');
              if (parts.length >= 2) closeMins = parseInt(parts[0], 10) * 60 + parseInt(parts[1], 10);
            }
          }
        }

        // Calculate if this day is currently open (only meaningful for today)
        let isDayOpen = false;
        if (isToday && !isClosed && openMins !== null && closeMins !== null) {
          if (closeMins > openMins) {
            isDayOpen = currentMinutes >= openMins && currentMinutes < closeMins;
          } else {
            // Overnight: open if after openMins OR before closeMins
            isDayOpen = currentMinutes >= openMins || currentMinutes < closeMins;
          }
        } else if (isToday && !isClosed && openMins === null) {
          // Fallback default hours 10:00 – 21:30
          isDayOpen = currentMinutes >= 600 && currentMinutes < 1290;
        }

        const row = document.createElement('div');
        row.className = `flex items-center justify-between text-sm py-2.5 px-3 rounded-xl ${
          isToday
            ? 'bg-jubilee-navy-light text-jubilee-navy font-bold border border-jubilee-navy/20'
            : isClosed
              ? 'text-slate-400 opacity-60'
              : 'text-slate-600 hover:bg-slate-50 transition-colors'
        }`;

        // Left: day name + Today badge + live status dot
        const leftWrap = document.createElement('div');
        leftWrap.className = 'flex items-center gap-2';

        const daySpan = document.createElement('span');
        daySpan.textContent = dayName;
        leftWrap.appendChild(daySpan);

        if (isToday) {
          const todayBadge = document.createElement('span');
          todayBadge.className = 'text-[10px] bg-jubilee-navy text-white px-2 py-0.5 rounded-full font-semibold';
          todayBadge.textContent = 'Today';
          leftWrap.appendChild(todayBadge);

          // Live status dot — only shown for today
          if (!isClosed) {
            const dot = document.createElement('span');
            dot.className = `w-2 h-2 rounded-full shrink-0 ${isDayOpen ? 'bg-emerald-500 animate-pulse' : 'bg-rose-400'}`;
            dot.setAttribute('title', isDayOpen ? 'Currently open' : 'Currently closed');
            leftWrap.appendChild(dot);
          }
        }

        // Right: time string
        const rightSpan = document.createElement('span');
        rightSpan.className = isClosed ? 'text-rose-400 font-semibold text-xs' : 'font-mono text-xs';
        rightSpan.textContent = timeStr;

        // Special notes if available
        if (tenantHour?.specialNotes) {
          const note = document.createElement('div');
          note.className = 'text-[10px] text-slate-400 mt-0.5 col-span-full px-3 pb-1';
          note.textContent = tenantHour.specialNotes;
          row.appendChild(leftWrap);
          row.appendChild(rightSpan);
          fragment.appendChild(row);
          fragment.appendChild(note);
          return;
        }

        row.append(leftWrap, rightSpan);
        fragment.appendChild(row);
      });

      hoursList.replaceChildren(fragment);
    }

    // Emit floor highlight event so BuildingFloorExplorer can highlight the tenant's floor
    const floorLevel = tenant.floorLevel;
    if (floorLevel) {
      window.dispatchEvent(new CustomEvent('jubilee:highlightFloor', {
        detail: { floorLevel, unitNumber: tenant.unitNumber, tenantName: tenant.name }
      }));
    }
  }

  function openDrawer(rawTenant: any) {
    if (!panel || !backdrop) return;
    populateDrawerUI(rawTenant);
    panel.classList.add('open');
    backdrop.classList.add('open');
    panel.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeDrawer() {
    if (!panel || !backdrop) return;
    panel.classList.remove('open');
    backdrop.classList.remove('open');
    panel.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    // Clear floor highlight on close
    window.dispatchEvent(new CustomEvent('jubilee:clearFloorHighlight'));
  }

  closeBtn?.addEventListener('click', closeDrawer);
  backdrop?.addEventListener('click', closeDrawer);

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && panel?.classList.contains('open')) {
      closeDrawer();
    }
  });

  (window as any).openTenantDrawer = openDrawer;
  (window as any).closeTenantDrawer = closeDrawer;
</script>
