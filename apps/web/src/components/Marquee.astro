---
const defaultRow1 = [
  { alt: 'Bantianyao Grilled Fish logo', src: '/images/tenants/bantianyao-logo.png' },
  { alt: 'AGrader Learning Centre logo', src: '/images/tenants/agrader-logo.png' },
  { alt: 'Ya Kun Kaya Toast logo', src: '/images/tenants/yakun-logo.png' },
  { alt: 'My Drum School logo', src: '/images/tenants/mydrumschool-logo.png' },
  { alt: 'Ashi Foot Reflexology logo', src: '/images/tenants/ashi-logo.png' },
  { alt: 'Jeong-In Taekwondo logo', src: '/images/tenants/jeongin-logo.png' }
];

const defaultRow2 = [
  { alt: 'Subway logo', src: '/images/tenants/subway-logo.png' },
  { alt: 'Artlette Art Studio logo', src: '/images/tenants/artlette-logo.png' },
  { alt: 'Tianyi InMed TCM Clinic logo', src: '/images/tenants/tianyi-logo.png' },
  { alt: 'LCentral English logo', src: '/images/tenants/lcentral-logo.png' },
  { alt: '7 Studio Hair Salon logo', src: '/images/tenants/7studio-logo.png' },
  { alt: 'The Chinese Wedding Shop logo', src: '/images/tenants/chinesewedding-logo.png' }
];
---

<div class="flex flex-col gap-3 py-6 overflow-hidden" style="mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent); -webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);" aria-hidden="true">
  <!-- Row 1 -->
  <div class="marquee-track flex w-max items-center gap-12 px-6">
    {defaultRow1.concat(defaultRow1).map((item) => (
      <img
        src={item.src}
        alt={item.alt}
        class="h-10 w-auto object-contain grayscale opacity-70 mix-blend-multiply transition-all duration-300 hover:grayscale-0 hover:opacity-100"
      />
    ))}
  </div>

  <!-- Row 2 -->
  <div class="marquee-track reverse flex w-max items-center gap-12 px-6">
    {defaultRow2.concat(defaultRow2).map((item) => (
      <img
        src={item.src}
        alt={item.alt}
        class="h-10 w-auto object-contain grayscale opacity-70 mix-blend-multiply transition-all duration-300 hover:grayscale-0 hover:opacity-100"
      />
    ))}
  </div>
</div>

<style>
  @keyframes marquee-scroll {
    to { transform: translateX(-50%); }
  }
  .marquee-track {
    animation: marquee-scroll 70s linear infinite;
    will-change: transform;
  }
  .marquee-track:hover {
    animation-play-state: paused;
  }
  .marquee-track.reverse {
    animation-direction: reverse;
  }
</style>
