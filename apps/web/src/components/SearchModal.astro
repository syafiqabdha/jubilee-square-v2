---
import { FALLBACK_TENANTS } from '../lib/tenant-roster';
---

<div class="search-modal-backdrop" id="search-modal" role="dialog" aria-modal="true" aria-label="Global Store Search" aria-hidden="true">
  <div class="search-modal-card">
    <div class="search-modal-input-wrap">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" style="color:var(--color-brand-navy);flex-shrink:0;">
        <circle cx="8.5" cy="8.5" r="5.5" stroke="currentColor" stroke-width="2"/>
        <path d="M13 13l4.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
      <input
        type="search"
        id="global-search-input"
        class="search-modal-input"
        placeholder="Type a store, category (e.g. food, tuition), or unit #..."
        autocomplete="off"
        spellcheck="false"
        role="combobox"
        aria-expanded="false"
        aria-autocomplete="list"
        aria-controls="search-modal-results"
      />
      <button class="drawer-btn-close" id="search-modal-close" aria-label="Close search modal" style="width:28px;height:28px;">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
          <path d="M2 2l10 10M12 2L2 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    <div class="search-modal-results" id="search-modal-results" role="listbox" aria-label="Search results">
      <!-- Search results populate dynamically via safe DOM nodes -->
      <div style="padding: 24px 16px; text-align: center; color: var(--color-text-muted); font-size: 0.9rem;" id="search-empty-hint">
        Type keywords to instantly search 23 directory tenants across 4 levels.
      </div>
    </div>

    <div style="padding: 10px 16px; background: var(--color-surface-muted); border-top: 1px solid var(--color-border); display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--color-text-muted);">
      <span>Navigate with <kbd style="padding:1px 4px;background:#fff;border:1px solid #cbd5e1;border-radius:3px;">↑</kbd> <kbd style="padding:1px 4px;background:#fff;border:1px solid #cbd5e1;border-radius:3px;">↓</kbd></span>
      <span>Select <kbd style="padding:1px 4px;background:#fff;border:1px solid #cbd5e1;border-radius:3px;">↵</kbd></span>
      <span>Close <kbd style="padding:1px 4px;background:#fff;border:1px solid #cbd5e1;border-radius:3px;">ESC</kbd></span>
    </div>
  </div>
</div>

<script define:vars={{ tenants: FALLBACK_TENANTS }}>
  const modal = document.getElementById('search-modal');
  const input = document.getElementById('global-search-input');
  const resultsContainer = document.getElementById('search-modal-results');
  const closeBtn = document.getElementById('search-modal-close');
  let selectedIndex = -1;
  let currentResults = [];

  function openSearchModal() {
    if (!modal) return;
    modal.classList.add('open');
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    setTimeout(() => {
      input?.focus();
    }, 50);
  }

  function closeSearchModal() {
    if (!modal) return;
    modal.classList.remove('open');
    modal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    if (input) {
      input.value = '';
      input.setAttribute('aria-expanded', 'false');
      input.removeAttribute('aria-activedescendant');
    }
    renderResults([]);
  }

  function selectTenant(tenant) {
    if (!tenant) return;
    closeSearchModal();
    if (typeof window.openTenantDrawer === 'function') {
      window.openTenantDrawer(tenant);
    } else {
      window.location.href = `/stores/${encodeURIComponent(tenant.slug)}`;
    }
  }

  function updateSelection() {
    if (!resultsContainer) return;
    const items = resultsContainer.querySelectorAll('.search-result-item');
    items.forEach((item, idx) => {
      if (idx === selectedIndex) {
        item.classList.add('highlighted');
        item.setAttribute('aria-selected', 'true');
        input?.setAttribute('aria-activedescendant', item.id);
        item.scrollIntoView({ block: 'nearest' });
      } else {
        item.classList.remove('highlighted');
        item.setAttribute('aria-selected', 'false');
      }
    });
    if (selectedIndex === -1) {
      input?.removeAttribute('aria-activedescendant');
    }
  }

  function renderResults(matches) {
    currentResults = matches;
    selectedIndex = -1;
    if (!resultsContainer) return;

    const query = (input?.value || '').trim();

    if (!query) {
      input?.setAttribute('aria-expanded', 'false');
      const hint = document.createElement('div');
      hint.style.cssText = 'padding: 24px 16px; text-align: center; color: var(--color-text-muted); font-size: 0.9rem;';
      hint.textContent = 'Type keywords to instantly search 23 directory tenants across 4 levels.';
      resultsContainer.replaceChildren(hint);
      return;
    }

    if (matches.length === 0) {
      input?.setAttribute('aria-expanded', 'false');
      const emptyDiv = document.createElement('div');
      emptyDiv.style.cssText = 'padding: 24px 16px; text-align: center; color: var(--color-text-muted); font-size: 0.9rem;';
      emptyDiv.appendChild(document.createTextNode('No stores found matching "'));
      const strong = document.createElement('strong');
      strong.textContent = query;
      emptyDiv.appendChild(strong);
      emptyDiv.appendChild(document.createTextNode('".'));
      resultsContainer.replaceChildren(emptyDiv);
      return;
    }

    input?.setAttribute('aria-expanded', 'true');
    const fragment = document.createDocumentFragment();

    matches.forEach((t, idx) => {
      const item = document.createElement('div');
      item.className = 'search-result-item';
      item.id = `search-opt-${idx}`;
      item.setAttribute('data-index', String(idx));
      item.setAttribute('data-slug', t.slug || '');
      item.setAttribute('data-id', t.id || '');
      item.setAttribute('role', 'option');
      item.setAttribute('aria-selected', 'false');

      const infoDiv = document.createElement('div');
      const titleDiv = document.createElement('div');
      titleDiv.className = 'search-result-title';
      titleDiv.textContent = t.name || '';

      const metaDiv = document.createElement('div');
      metaDiv.className = 'search-result-meta';

      const catSpan = document.createElement('span');
      catSpan.textContent = t.categoryName || '';

      const dotSpan = document.createElement('span');
      dotSpan.textContent = '•';

      const unitSpan = document.createElement('span');
      unitSpan.textContent = `${t.unitNumber || ''} (${t.floorLevel || ''})`;

      metaDiv.append(catSpan, dotSpan, unitSpan);
      infoDiv.append(titleDiv, metaDiv);

      const actionSpan = document.createElement('span');
      actionSpan.style.cssText = 'font-size:0.8rem;font-weight:700;color:var(--color-brand-magenta);';
      actionSpan.textContent = 'View →';

      item.append(infoDiv, actionSpan);

      item.addEventListener('mouseenter', () => {
        selectedIndex = idx;
        updateSelection();
      });

      item.addEventListener('click', () => {
        selectTenant(t);
      });

      fragment.appendChild(item);
    });

    resultsContainer.replaceChildren(fragment);
  }

  function handleSearch(query) {
    const q = query.trim().toLowerCase();
    if (!q) {
      renderResults([]);
      return;
    }

    const matches = tenants.filter((t) => {
      const name = (t.name || '').toLowerCase();
      const cat = (t.categoryName || '').toLowerCase();
      const unit = (t.unitNumber || '').toLowerCase();
      const summary = (t.summary || '').toLowerCase();
      const tags = (t.tags || []).join(' ').toLowerCase();
      return name.includes(q) || cat.includes(q) || unit.includes(q) || summary.includes(q) || tags.includes(q);
    });

    renderResults(matches);
  }

  input?.addEventListener('input', (e) => {
    handleSearch(e.target.value);
  });

  input?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      if (currentResults.length > 0) {
        selectedIndex = (selectedIndex + 1) % currentResults.length;
        updateSelection();
      }
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      if (currentResults.length > 0) {
        selectedIndex = selectedIndex <= 0 ? currentResults.length - 1 : selectedIndex - 1;
        updateSelection();
      }
    } else if (e.key === 'Enter') {
      e.preventDefault();
      if (selectedIndex >= 0 && selectedIndex < currentResults.length) {
        selectTenant(currentResults[selectedIndex]);
      } else if (currentResults.length > 0) {
        selectTenant(currentResults[0]);
      }
    }
  });

  closeBtn?.addEventListener('click', closeSearchModal);

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      closeSearchModal();
    }
  });

  window.addEventListener('keydown', (e) => {
    // Cmd+K or Ctrl+K trigger
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      if (modal?.classList.contains('open')) {
        closeSearchModal();
      } else {
        openSearchModal();
      }
    }

    // Escape
    if (e.key === 'Escape' && modal?.classList.contains('open')) {
      closeSearchModal();
    }
  });

  window.openGlobalSearch = openSearchModal;
</script>
