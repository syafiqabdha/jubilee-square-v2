---
import type { Category, Tenant } from '@jubilee/shared';
import { CATEGORY_EMOJI_MAP } from '@jubilee/shared';

interface Props {
  categories: Category[];
  tenants: Tenant[];
  initialCategory?: string;
  initialSearch?: string;
}

const { categories, tenants, initialCategory = 'all', initialSearch = '' } = Astro.props;

---

<section class="py-12 md:py-16 px-4 max-w-7xl mx-auto w-full" id="directory" aria-labelledby="directory-heading">
  <!-- Header -->
  <div class="mb-8">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold tracking-wider uppercase text-jubilee-navy bg-jubilee-navy-light mb-3">
      Store Directory
    </div>
    <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-2" id="directory-heading">
      Find What You Need
    </h2>
    <p class="text-slate-600 max-w-xl text-base sm:text-lg">
      Explore all {tenants.length} stores, dining outlets, tuition &amp; music academies across 4 levels at Jubilee Square.
    </p>
  </div>

  <!-- Search & Category Filter Controls -->
  <div class="flex flex-col gap-4 mb-8">
    <!-- Instant Search Bar -->
    <div class="relative w-full max-w-xl">
      <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <circle cx="7.5" cy="7.5" r="5.5" stroke="currentColor" stroke-width="2"/>
          <path d="M12 12l3.5 3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </div>
      <input
        type="search"
        id="directory-search-input"
        class="w-full pl-10 pr-10 py-3 bg-white border border-slate-200 rounded-2xl text-slate-900 placeholder-slate-400 font-medium focus:outline-none focus:ring-2 focus:ring-jubilee-navy focus:border-transparent shadow-sm transition-all"
        placeholder="Filter by store name, food, course, or unit (e.g. #02-01)..."
        aria-label="Filter stores"
        value={initialSearch}
        autocomplete="off"
        spellcheck="false"
      />
      <button
        type="button"
        id="directory-search-clear"
        class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-400 hover:text-slate-700 hidden"
        aria-label="Clear search"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    <!-- Interactive Category Pills with Emoji -->
    <div class="pills-container" id="category-pills" role="group" aria-label="Filter by store category">
      <button
        class={`category-pill ${initialCategory === 'all' ? 'active' : ''}`}
        data-category="all"
        type="button"
        aria-pressed={initialCategory === 'all' ? 'true' : 'false'}
      >
        <span>All</span>
        <span class="pill-count-badge">{tenants.length}</span>
      </button>

      {categories.map((cat) => {
        const count = tenants.filter((t) => t.categorySlug === cat.slug).length;
        const emoji = CATEGORY_EMOJI_MAP[cat.slug] || '';
        const isSelected = initialCategory === cat.slug;
        return (
          <button
            class={`category-pill ${isSelected ? 'active' : ''}`}
            data-category={cat.slug}
            type="button"
            aria-pressed={isSelected ? 'true' : 'false'}
          >
            <span>{cat.name} {emoji}</span>
            <span class="pill-count-badge">{count}</span>
          </button>
        );
      })}
    </div>

  </div>

  <!-- Live Results Summary -->
  <div class="flex items-center justify-between text-sm text-slate-500 font-medium mb-6" id="results-count-bar" aria-live="polite">
    <span>Showing <strong id="results-count" class="text-slate-900">{tenants.length}</strong> tenants</span>
  </div>

  <!-- Modern Store Cards Grid -->
  <div class="tenant-grid-modern" id="tenants-grid" role="list" aria-label="Tenant Directory Grid">
    {tenants.map((t) => (
      <article
        class="store-card group"
        data-id={t.id}
        data-slug={t.slug}
        data-category={t.categorySlug}
        data-floor={t.floorLevel}
        data-search={`${t.name} ${t.summary} ${t.unitNumber} ${t.floorLevel} ${t.categoryName || ''} ${(t.tags || []).join(' ')}`.toLowerCase()}
        role="listitem"
        tabindex="0"
      >
        {t.logoUrl && (
          <div class="store-card-logo-wrap">
            <img
              src={t.logoUrl}
              alt={`${t.name} Logo`}
              class="store-card-logo"
              loading="lazy"
              decoding="async"
              width="205"
              height="120"
            />
          </div>
        )}

        <div class="store-card-header">
          <span class="store-card-category">
            {t.categoryName} {t.categorySlug ? CATEGORY_EMOJI_MAP[t.categorySlug] || '' : ''}
          </span>
          <span class="store-card-unit">
            {t.floorLevel} • {t.unitNumber}
          </span>
        </div>

        <div class="px-5 flex-1">
          <h3 class="store-card-name group-hover:text-jubilee-navy transition-colors">
            {t.name}
          </h3>
          <p class="store-card-summary">
            {t.summary}
          </p>
        </div>

        <div class="store-card-footer">
          <!-- Real-time Open/Closed Badge Container (hydrated dynamically) -->
          <div class="store-status-container" data-tenant-id={t.id}>
            <span class="status-badge-open">
              <span class="status-dot-open"></span>
              <span>Open Today</span>
            </span>
          </div>

          <span class="store-card-action">
            Details
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="transition-transform group-hover:translate-x-1">
              <path d="M3 7h8M8 4l3 3-3 3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </div>
      </article>
    ))}

    <!-- Empty State -->
    <div class="col-span-full py-16 text-center hidden bg-white rounded-2xl border border-slate-200 p-8 shadow-sm" id="directory-empty-state">
      <div class="text-4xl mb-3">🔍</div>
      <h3 class="text-lg font-bold text-slate-900 mb-1">No matching stores found</h3>
      <p class="text-slate-500 text-sm mb-4">Try checking your spelling or choosing a different category or floor.</p>
      <button
        type="button"
        id="directory-reset-btn"
        class="btn-primary-navy inline-flex items-center text-sm py-2 px-4 cursor-pointer"
      >
        Reset Filters
      </button>
    </div>
  </div>
</section>

<!-- JSON Data serialization for clean client script module bundling -->
<script type="application/json" id="jubilee-directory-tenants" set:html={JSON.stringify(tenants)} />

<script>
  import { getTenantOpeningStatus } from '../lib/opening-hours';

  const dataEl = document.getElementById('jubilee-directory-tenants');
  const tenantsList: any[] = dataEl ? JSON.parse(dataEl.textContent || '[]') : [];

  const searchInput = document.getElementById('directory-search-input') as HTMLInputElement | null;
  const searchClear = document.getElementById('directory-search-clear');
  const categoryPills = Array.from(document.querySelectorAll('.category-pill'));
  const storeCards = Array.from(document.querySelectorAll('.store-card'));
  const resultsCount = document.getElementById('results-count');
  const emptyState = document.getElementById('directory-empty-state');
  const resetBtn = document.getElementById('directory-reset-btn');

  let activeCategory = 'all';
  let activeSearchQuery = (searchInput?.value || '').trim().toLowerCase();

  // Calculate real-time Open / Closed status using centralized engine
  function updateStoreStatuses() {
    const now = new Date();
    document.querySelectorAll('.store-status-container').forEach((el) => {
      const tenantId = el.getAttribute('data-tenant-id');
      const tenant = tenantsList.find((t: any) => t.id === tenantId);
      if (!tenant) return;

      const status = getTenantOpeningStatus(tenant.operatingHours, now);

      const badge = document.createElement('span');
      const dot = document.createElement('span');
      const text = document.createElement('span');

      if (status.isOpen) {
        badge.className = 'status-badge-open';
        dot.className = 'status-dot-open';
      } else {
        badge.className = 'status-badge-closed';
        dot.className = 'status-dot-closed';
      }

      text.textContent = status.statusText;
      badge.append(dot, text);
      el.replaceChildren(badge);
    });
  }

  function filterCards() {
    let visibleCount = 0;

    storeCards.forEach((card) => {
      const cardCategory = card.getAttribute('data-category');
      const cardSearch = card.getAttribute('data-search') || '';

      const matchesCat = activeCategory === 'all' || cardCategory === activeCategory;
      const matchesSearch = !activeSearchQuery || cardSearch.includes(activeSearchQuery);

      if (matchesCat && matchesSearch) {
        (card as HTMLElement).style.display = 'flex';
        visibleCount++;
      } else {
        (card as HTMLElement).style.display = 'none';
      }
    });

    if (resultsCount) resultsCount.textContent = String(visibleCount);

    if (emptyState) {
      if (visibleCount === 0) {
        emptyState.classList.remove('hidden');
      } else {
        emptyState.classList.add('hidden');
      }
    }
  }

  // Category Pill click handlers
  categoryPills.forEach((pill) => {
    pill.addEventListener('click', () => {
      categoryPills.forEach((p) => {
        p.classList.remove('active');
        p.setAttribute('aria-pressed', 'false');
      });
      pill.classList.add('active');
      pill.setAttribute('aria-pressed', 'true');
      activeCategory = pill.getAttribute('data-category') || 'all';
      filterCards();
    });
  });

  // Search input handler
  searchInput?.addEventListener('input', (e: Event) => {
    activeSearchQuery = ((e.target as HTMLInputElement).value || '').trim().toLowerCase();
    if (activeSearchQuery) {
      searchClear?.classList.remove('hidden');
    } else {
      searchClear?.classList.add('hidden');
    }
    filterCards();
  });

  searchClear?.addEventListener('click', () => {
    if (searchInput) {
      searchInput.value = '';
      activeSearchQuery = '';
      searchClear.classList.add('hidden');
      searchInput.focus();
      filterCards();
    }
  });

  resetBtn?.addEventListener('click', () => {
    activeCategory = 'all';
    activeSearchQuery = '';
    if (searchInput) searchInput.value = '';
    searchClear?.classList.add('hidden');
    categoryPills.forEach((p) => {
      if (p.getAttribute('data-category') === 'all') {
        p.classList.add('active');
        p.setAttribute('aria-pressed', 'true');
      } else {
        p.classList.remove('active');
        p.setAttribute('aria-pressed', 'false');
      }
    });
    filterCards();
  });

  // Card click opens drawer
  storeCards.forEach((card) => {
    const handleCardClick = () => {
      const tenantId = card.getAttribute('data-id');
      const tenant = tenantsList.find((t: any) => t.id === tenantId);
      if (tenant && typeof (window as any).openTenantDrawer === 'function') {
        (window as any).openTenantDrawer(tenant);
      } else {
        const slug = card.getAttribute('data-slug');
        window.location.href = `/stores/${encodeURIComponent(slug || '')}`;
      }
    };

    card.addEventListener('click', handleCardClick);
    card.addEventListener('keydown', (e: Event) => {
      const keyEvent = e as KeyboardEvent;
      if (keyEvent.key === 'Enter' || keyEvent.key === ' ') {
        keyEvent.preventDefault();
        handleCardClick();
      }
    });
  });

  // Initial runs
  updateStoreStatuses();
  filterCards();
</script>
