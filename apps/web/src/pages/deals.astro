---
import Layout from '../layouts/Layout.astro';
import CTA from '../components/CTA.astro';
import { api } from '../lib/api-client';

export const prerender = false;

// "Today" in Singapore, as YYYY-MM-DD, so a deal ending today is still shown.
const today = new Intl.DateTimeFormat('en-CA', {
  timeZone: 'Asia/Singapore',
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
}).format(new Date());

// The API may return full ISO timestamps; only the calendar date matters here.
const day = (d: string) => String(d).slice(0, 10);

const all = await api.getPromotions();
const deals = all
  .filter((p) => p.isActive && day(p.startDate) <= today && day(p.endDate) >= today)
  .sort((a, b) => Number(b.isFeatured) - Number(a.isFeatured) || a.displayOrder - b.displayOrder);

const fmt = (d: string) =>
  new Date(`${day(d)}T00:00:00+08:00`).toLocaleDateString('en-SG', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
    timeZone: 'Asia/Singapore',
  });
---

<Layout
  title="Deals & Promotions — Jubilee Square"
  description="Current deals and promotions from tenants at Jubilee Square, Ang Mo Kio."
  activePage="deals"
>
  <div class="max-w-6xl mx-auto px-4 py-12 md:py-16">
    <div class="text-center max-w-2xl mx-auto mb-10">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider text-jubilee-red bg-jubilee-red-light mb-3">
        Deals &amp; Promotions
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight mb-4">
        What's on at <span class="text-jubilee-navy">Jubilee Square</span>
      </h1>
      <p class="text-slate-600 text-base sm:text-lg leading-relaxed">
        Offers from our tenants, updated by the stores themselves. Check each deal's terms before you visit.
      </p>
    </div>

    {deals.length > 0 ? (
      <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" role="list">
        {deals.map((p) => (
          <li class="group bg-white border border-slate-200 rounded-3xl overflow-hidden shadow-sm hover:shadow-card-hover transition-shadow flex flex-col">
            <div class="relative aspect-[1200/630] bg-jubilee-navy">
              <img
                src={p.bannerUrl}
                alt=""
                width="1200"
                height="630"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover"
              />
              {p.badgeText && (
                <span class="absolute top-3 left-3 px-3 py-1 rounded-full text-xs font-extrabold tracking-wide bg-jubilee-red text-white shadow">
                  {p.badgeText}
                </span>
              )}
            </div>
            <div class="p-6 flex flex-col flex-1">
              {p.tenantName && (
                <p class="text-xs font-bold uppercase tracking-wider text-jubilee-navy mb-2">{p.tenantName}</p>
              )}
              <h2 class="text-lg font-bold text-slate-900 leading-snug mb-2">{p.title}</h2>
              {p.summary && <p class="text-sm text-slate-600 leading-relaxed mb-4">{p.summary}</p>}
              {p.termsConditions && (
                <p class="text-xs text-slate-500 leading-relaxed mb-4">T&amp;Cs: {p.termsConditions}</p>
              )}
              <div class="mt-auto flex items-center justify-between gap-3 pt-4 border-t border-slate-100">
                <span class="text-xs font-semibold text-slate-500">Until {fmt(p.endDate)}</span>
                {p.tenantSlug && (
                  <a
                    href={`/stores/${p.tenantSlug}`}
                    class="text-sm font-bold text-jubilee-navy hover:text-jubilee-red transition-colors"
                  >
                    View store &rarr;
                  </a>
                )}
              </div>
            </div>
          </li>
        ))}
      </ul>
    ) : (
      <div class="bg-white border border-slate-200 rounded-3xl p-10 text-center shadow-sm max-w-xl mx-auto">
        <p class="text-lg font-bold text-slate-900 mb-2">No deals running right now</p>
        <p class="text-slate-600 mb-6">New promotions are added by our tenants regularly. Meanwhile, browse what's at the mall.</p>
        <a href="/directory" class="btn-cta-getting-here inline-flex">Browse the directory</a>
      </div>
    )}
  </div>
  <CTA />
</Layout>
