---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Deals & Promotions — Jubilee Square"
  description="Discover exclusive deals and promotions from tenants at Jubilee Square, Ang Mo Kio."
  activePage="deals"
>
  <section class="container mx-auto px-4 py-16 md:py-24">
    <div class="max-w-3xl mx-auto text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-slate-900 mb-6">
        Deals & Promotions
      </h1>
      <p class="text-lg text-slate-600">
        Check back soon for exclusive deals and special offers from our tenants.
      </p>
    </div>
  </section>
</Layout>
