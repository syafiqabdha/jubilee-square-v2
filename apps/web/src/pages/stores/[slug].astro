---
import Layout from '../../layouts/Layout.astro';
import CTA from '../../components/CTA.astro';
import { api } from '../../lib/api-client';

export const prerender = false;

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/directory');
}

let tenant;
try {
  tenant = await api.getTenantBySlug(slug);
} catch {
  return Astro.redirect('/directory');
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: tenant.name,
  description: tenant.description || tenant.summary,
  telephone: tenant.phone || undefined,
  email: tenant.email || undefined,
  url: tenant.website || `https://jubileesq.com.sg/stores/${tenant.slug}`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: `61 Ang Mo Kio Ave 8, ${tenant.unitNumber}`,
    addressLocality: 'Singapore',
    postalCode: '569814',
    addressCountry: 'SG',
  },
  openingHoursSpecification: (tenant.operatingHours || []).map((h: any) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'][h.dayOfWeek],
    opens: h.openTime?.slice(0, 5) || '10:00',
    closes: h.closeTime?.slice(0, 5) || '21:30',
  })),
};
---

<Layout
  title={`${tenant.name} — Jubilee Square Ang Mo Kio`}
  description={tenant.summary}
  activePage="directory"
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div style="padding-top: 120px; max-width: 900px; margin: 0 auto; padding-left: 20px; padding-right: 20px; padding-bottom: 80px;">
    <a href="/directory" class="btn-secondary" style="display: inline-flex; margin-bottom: 24px; padding: 6px 14px; font-size: 0.85rem;">
      &larr; Back to Directory
    </a>

    <div style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-xl); padding: 36px; margin-bottom: 32px;">
      <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-bottom: 16px;">
        <span class="card-cat" style={`--cat-color: ${tenant.categoryColor || '#c9f23e'}; font-size: 0.9rem; padding: 4px 12px;`}>
          {tenant.categoryName}
        </span>
        <span class="card-unit" style="font-size: 1rem; font-weight: 700; color: var(--ink);">
          {tenant.floorLevel} · {tenant.unitNumber}
        </span>
      </div>

      <h1 style="font-size: 2.25rem; font-weight: 800; margin-bottom: 16px; letter-spacing: -0.02em;">
        {tenant.name}
      </h1>

      <p style="font-size: 1.15rem; color: var(--muted); line-height: 1.6; margin-bottom: 24px;">
        {tenant.description || tenant.summary}
      </p>

      <div style="display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 32px;">
        {tenant.phone && (
          <a href={`tel:${tenant.phone.replace(/\s+/g, '')}`} class="btn-primary" style="display: inline-flex;">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 3a1 1 0 011-1h2l1.5 3.5-1.5 1 2.5 2.5 1-1.5L13 9v2a1 1 0 01-1 1C6 12 4 7 3 3z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Call {tenant.phone}
          </a>
        )}
        <a href="https://maps.google.com/?q=61+Ang+Mo+Kio+Ave+8+Singapore+569814" target="_blank" rel="noopener" class="btn-secondary" style="display: inline-flex;">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 2C5.24 2 3 4.24 3 7c0 4.17 5 9 5 9s5-4.83 5-9c0-2.76-2.24-5-5-5zm0 6.5a1.5 1.5 0 110-3 1.5 1.5 0 010 3z" fill="currentColor"/></svg>
          Get Directions
        </a>
        {tenant.website && (
          <a href={tenant.website} target="_blank" rel="noopener" class="btn-secondary" style="display: inline-flex;">
            Visit Website &nearr;
          </a>
        )}
      </div>

      <div style="border-top: 1px solid var(--border); padding-top: 24px;">
        <h2 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 16px;">Opening Hours</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px;">
          {(tenant.operatingHours || []).map((h: any) => (
            <div style="background: var(--surface-2); padding: 12px 16px; border-radius: var(--radius-sm); display: flex; justify-content: space-between;">
              <span style="font-weight: 600; font-size: 0.9rem;">{h.dayName}</span>
              <span style="color: var(--muted); font-size: 0.9rem;">{h.openTime?.slice(0,5)} – {h.closeTime?.slice(0,5)}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
  <CTA />
</Layout>
