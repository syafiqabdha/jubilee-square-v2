---
import Layout from '../../layouts/Layout.astro';
import CTA from '../../components/CTA.astro';
import { api } from '../../lib/api-client';

export const prerender = false;

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/directory');
}

let tenant;
try {
  tenant = await api.getTenantBySlug(slug);
} catch {
  return Astro.redirect('/directory');
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: tenant.name,
  description: tenant.description || tenant.summary,
  telephone: tenant.phone || undefined,
  email: tenant.email || undefined,
  url: tenant.website || `https://jubileesq.com.sg/stores/${tenant.slug}`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: `61 Ang Mo Kio Ave 8, ${tenant.unitNumber}`,
    addressLocality: 'Singapore',
    postalCode: '569814',
    addressCountry: 'SG',
  },
  openingHoursSpecification: (tenant.operatingHours || []).map((h: any) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'][h.dayOfWeek],
    opens: h.openTime?.slice(0, 5) || '10:00',
    closes: h.closeTime?.slice(0, 5) || '21:30',
  })),
};
---

<Layout
  title={`${tenant.name} — Jubilee Square Ang Mo Kio`}
  description={tenant.summary}
  activePage="directory"
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="max-w-4xl mx-auto px-4 py-8 md:py-12">
    <a href="/directory" class="inline-flex items-center gap-2 text-sm font-semibold text-slate-600 hover:text-jubilee-navy mb-6 transition-colors">
      &larr; Back to Full Directory
    </a>

    <div class="bg-white border border-slate-200 rounded-3xl p-6 sm:p-10 shadow-sm mb-8">
      <div class="flex items-center justify-between flex-wrap gap-3 mb-4">
        <span class="text-xs font-bold uppercase tracking-wider text-jubilee-navy bg-jubilee-navy-light px-3 py-1 rounded-full">
          {tenant.categoryName}
        </span>
        <span class="text-sm font-bold text-slate-700 bg-slate-100 px-3 py-1 rounded-lg">
          📍 Level {tenant.floorLevel?.replace('L', '') || tenant.floorLevel} • {tenant.unitNumber}
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight mb-4">
        {tenant.name}
      </h1>

      <p class="text-base sm:text-lg text-slate-600 leading-relaxed mb-8">
        {tenant.description || tenant.summary}
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-wrap gap-3 mb-8">
        {tenant.phone && (
          <a href={`tel:${tenant.phone.replace(/\s+/g, '')}`} class="btn-cta-getting-here text-sm py-2.5 px-5">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            Call {tenant.phone}
          </a>
        )}
        <a href="https://maps.google.com/?q=61+Ang+Mo+Kio+Ave+8+Singapore+569814" target="_blank" rel="noopener noreferrer" class="btn-secondary-outline text-sm py-2.5 px-5">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="3 11 22 2 13 21 11 13 3 11"></polygon>
          </svg>
          Get Directions
        </a>
        {tenant.website && (
          <a href={tenant.website} target="_blank" rel="noopener noreferrer" class="btn-secondary-outline text-sm py-2.5 px-5">
            Visit Store Website &nearr;
          </a>
        )}
      </div>

      <!-- Opening Hours Grid -->
      <div class="border-t border-slate-100 pt-6">
        <h2 class="text-sm font-bold uppercase tracking-wider text-slate-400 mb-4">Weekly Operating Hours</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2.5">
          {(tenant.operatingHours || []).map((h: any) => (
            <div class="bg-slate-50 border border-slate-100 p-3 rounded-xl flex justify-between items-center text-sm">
              <span class="font-semibold text-slate-700">{h.dayName}</span>
              <span class="font-bold text-slate-900">{h.isClosed ? 'Closed' : `${h.openTime?.slice(0,5)} – ${h.closeTime?.slice(0,5)}`}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
  
  <CTA />
</Layout>
