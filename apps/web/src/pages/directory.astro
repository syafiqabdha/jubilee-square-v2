---
import Layout from '../layouts/Layout.astro';
import DirectorySection from '../components/DirectorySection.astro';
import CTA from '../components/CTA.astro';
import { api } from '../lib/api-client';

const categories = await api.getCategories();
const { tenants } = await api.getTenants();
---

<Layout
  title="Store Directory — Jubilee Square Ang Mo Kio"
  description="Search and filter through 23 stores, enrichment centres, hair salons, and dining spots at Jubilee Square AMK."
  activePage="directory"
>
  <DirectorySection categories={categories} tenants={tenants} />
  <CTA />
</Layout>
