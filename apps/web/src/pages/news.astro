---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="News & Updates — Jubilee Square"
  description="Latest news, announcements, and updates from Jubilee Square, Ang Mo Kio."
  activePage="news"
>
  <section class="container mx-auto px-4 py-16 md:py-24">
    <div class="max-w-3xl mx-auto text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-slate-900 mb-6">
        News & Updates
      </h1>
      <p class="text-lg text-slate-600">
        Stay tuned for the latest announcements, events, and updates from Jubilee Square.
      </p>
    </div>
  </section>
</Layout>
