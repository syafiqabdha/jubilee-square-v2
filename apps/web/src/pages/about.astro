---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="About Jubilee Square — Ang Mo Kio Community Mall"
  description="Learn more about Jubilee Square, a vibrant community mall in Ang Mo Kio offering dining, enrichment, and lifestyle options."
  activePage="about"
>
  <section class="container mx-auto px-4 py-16 md:py-24">
    <div class="max-w-3xl mx-auto text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-slate-900 mb-6">
        About Jubilee Square
      </h1>
      <p class="text-lg text-slate-600 mb-8">
        Jubilee Square is a community-focused mall located at 61 Ang Mo Kio Ave 8, 
        just 2 minutes from AMK MRT. We bring together 23 curated tenants across 
        dining, enrichment tuition, beauty wellness, and healthcare.
      </p>
      <p class="text-lg text-slate-600">
        More details coming soon.
      </p>
    </div>
  </section>
</Layout>
