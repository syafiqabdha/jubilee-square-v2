---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Services & Amenities — Jubilee Square"
  description="Discover the services and amenities available at Jubilee Square, Ang Mo Kio."
  activePage="services"
>
  <section class="container mx-auto px-4 py-16 md:py-24">
    <div class="max-w-3xl mx-auto text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-slate-900 mb-6">
        Services & Amenities
      </h1>
      <p class="text-lg text-slate-600">
        Jubilee Square offers a range of services and amenities to enhance your visit. 
        Details will be updated soon.
      </p>
    </div>
  </section>
</Layout>
