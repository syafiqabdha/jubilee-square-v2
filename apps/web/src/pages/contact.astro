---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact Us — Jubilee Square"
  description="Get in touch with Jubilee Square. Find our address, operating hours, and contact information."
  activePage="contact"
>
  <section class="container mx-auto px-4 py-16 md:py-24">
    <div class="max-w-3xl mx-auto text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-slate-900 mb-6">
        Contact Us
      </h1>
      <div class="text-lg text-slate-600 space-y-4">
        <p>
          <strong class="text-slate-900">Address:</strong><br />
          61 Ang Mo Kio Ave 8, Singapore 569814
        </p>
        <p>
          <strong class="text-slate-900">Getting Here:</strong><br />
          2 minutes walk from Ang Mo Kio MRT (NS16)
        </p>
        <p class="mt-8 text-slate-500">
          For leasing inquiries and general questions, please check back soon for updated contact details.
        </p>
      </div>
    </div>
  </section>
</Layout>
